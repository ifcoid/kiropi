# Kiropi Configuration

# Server port
KIROPI_PORT=50403

# MCP Server command (the command to start your MCP server)
# Examples:
#   KIROPI_MCP_COMMAND=npx
#   KIROPI_MCP_COMMAND=node
#   KIROPI_MCP_COMMAND=python
KIROPI_MCP_COMMAND=

# MCP Server arguments (space-separated, use quotes for args with spaces)
# Examples:
#   KIROPI_MCP_ARGS=-y @anthropic/mcp-server-kiro
#   KIROPI_MCP_ARGS=server.js
KIROPI_MCP_ARGS=

# MCP Transport type: "stdio" or "sse"
KIROPI_MCP_TRANSPORT=stdio

# MCP SSE URL (only if using SSE transport)
KIROPI_MCP_SSE_URL=

# API Key for REST endpoint authentication (leave empty to disable auth)
KIROPI_API_KEY=

# Default model name to report in responses
KIROPI_MODEL=kiropi-1

# Max concurrent requests
KIROPI_MAX_CONCURRENT=10

# Kiropi Configuration

# REST API port (for NSA/apps to call)
KIROPI_PORT=50403

# MCP SSE port (for Kiro to connect)
KIROPI_MCP_PORT=50404

# API Key for REST endpoint authentication (leave empty to disable auth)
KIROPI_API_KEY=

# Default model name to report in responses
KIROPI_MODEL=kiropi-1

# Max concurrent requests
KIROPI_MAX_CONCURRENT=10

# Prompt timeout in seconds (how long to wait for Kiro to respond)
KIROPI_PROMPT_TIMEOUT=120
